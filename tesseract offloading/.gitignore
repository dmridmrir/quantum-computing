# The bundled UPMEM SDK is part of the reproducible toolchain. Keep its shared
# libraries and device-runtime blobs even though generated files of the same
# types are ignored elsewhere.
!/simulator/tesseract_msc_bench/upmem_sdk/lib/*.so
!/simulator/tesseract_msc_bench/upmem_sdk/lib/*.so.*
!/simulator/tesseract_msc_bench/upmem_sdk/share/upmem/include/misc/*.bin

