# Generated experiment data and large workloads
# -----------------------------------------------------------------------------
results/
**/results/
**/traces/*_sample*/
**/workloads/*_100m*/
*.b8
*.log

# Generated simulator inputs and binaries (source fixtures such as .01, .dem,
# .stim, and the small versioned JSON traces remain tracked).
**/uPIMulator/bin/
**/uPIMulator/bin_*/
*.bin

