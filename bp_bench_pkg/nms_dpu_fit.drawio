<mxfile host="app.diagrams.net" modified="2026-05-14" version="21.0.0">
  <diagram name="NMS-DPU-Fit" id="nms-dpu-fit">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 배경 -->
        <mxCell id="bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="1480" height="1040" as="geometry" />
        </mxCell>

        <!-- 제목 -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px;&quot; color=&quot;#ffffff&quot;&gt;Why Normalized Min-Sum BP Fits UPMEM DPU Architecture&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C3E50;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1440" height="50" as="geometry" />
        </mxCell>

        <!-- 컬럼 헤더 -->
        <mxCell id="hdr_bp" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#ffffff&quot;&gt;Standard Belief Propagation (float32)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D94F3D;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="82" width="680" height="38" as="geometry" />
        </mxCell>
        <mxCell id="hdr_nms" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#ffffff&quot;&gt;Normalized Min-Sum on DPU (int16)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E86AB;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="82" width="680" height="38" as="geometry" />
        </mxCell>

        <!-- 중앙 구분선 -->
        <mxCell id="divider" value="" style="line;strokeColor=#BBBBBB;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="78" width="10" height="700" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- STEP 1: 데이터 표현 -->
        <!-- ═══════════════════════════════════ -->
        <mxCell id="s1_label" value="STEP 1 — Data Representation" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
          <mxGeometry x="35" y="132" width="280" height="18" as="geometry" />
        </mxCell>

        <!-- BP STEP1 그림 placeholder -->
        <mxCell id="s1_bp_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:10px;&quot;&gt;[ 그림: float32 비트 레이아웃 ]&lt;br/&gt;sign(1) | exponent(8) | mantissa(23)&lt;br/&gt;4 bytes per value&lt;br/&gt;→ WRAM 64KB에 ~16,000개 저장 가능&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#D94F3D;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="152" width="680" height="100" as="geometry" />
        </mxCell>
        <!-- BP STEP1 핵심 문구 -->
        <mxCell id="s1_bp_txt" value="&lt;font color=&quot;#E67E22&quot;&gt;⚠ 모든 연산에 FPU 필요 — DPU에 FPU 없음 → SW 에뮬레이션&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#E67E22;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="255" width="680" height="28" as="geometry" />
        </mxCell>

        <!-- NMS STEP1 그림 placeholder -->
        <mxCell id="s1_nms_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:10px;&quot;&gt;[ 그림: int16 비트 레이아웃 비교 ]&lt;br/&gt;sign(1) | value(15)&lt;br/&gt;2 bytes per value → WRAM에 2배 저장&lt;br/&gt;λ₀ = log((1−p)/p) × 256 으로 스케일링&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FB;strokeColor=#2E86AB;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="152" width="680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s1_nms_txt" value="&lt;font color=&quot;#27AE60&quot;&gt;✓ 정수 연산만 사용 — DPU ALU가 기본 지원, FPU 불필요&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#27AE60;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="255" width="680" height="28" as="geometry" />
        </mxCell>

        <!-- 화살표 -->
        <mxCell id="arr1_bp" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#D94F3D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s1_bp_txt" target="s2_bp_img">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr1_nms" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E86AB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s1_nms_txt" target="s2_nms_img">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- STEP 2: Check Node Update -->
        <!-- ═══════════════════════════════════ -->
        <mxCell id="s2_label" value="STEP 2 — Check Node Update" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
          <mxGeometry x="35" y="298" width="280" height="18" as="geometry" />
        </mxCell>

        <mxCell id="s2_bp_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:10px;&quot;&gt;[ 그림: tanh 함수 곡선 그래프 ]&lt;br/&gt;입력 x → tanh(x/2) → 곱 → atanh → 출력&lt;br/&gt;비선형 초월함수, 하드웨어 구현 불가&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#D94F3D;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="318" width="680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s2_bp_txt" value="&lt;font color=&quot;#E67E22&quot;&gt;⚠ tanh/atanh 초월함수 — HW 미지원, 곱셈 오차 누적&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#E67E22;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="421" width="680" height="28" as="geometry" />
        </mxCell>

        <mxCell id="s2_nms_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:10px;&quot;&gt;[ 그림: check node에서 min1/min2 트래킹 ]&lt;br/&gt;6개 입력값 → 한 번의 순회로 min1, min2 추출&lt;br/&gt;부호는 XOR 누적 (비트 연산 1개)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FB;strokeColor=#2E86AB;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="318" width="680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s2_nms_txt" value="&lt;font color=&quot;#27AE60&quot;&gt;✓ 정수 비교 + 부호 XOR만 사용 — 단일 사이클, 파이프라인 친화적&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#27AE60;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="421" width="680" height="28" as="geometry" />
        </mxCell>

        <mxCell id="arr2_bp" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#D94F3D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s2_bp_txt" target="s3_bp_img">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr2_nms" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E86AB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s2_nms_txt" target="s3_nms_img">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- STEP 3: Alpha Scaling -->
        <!-- ═══════════════════════════════════ -->
        <mxCell id="s3_label" value="STEP 3 — Alpha Scaling  (α = 0.625)" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
          <mxGeometry x="35" y="464" width="300" height="18" as="geometry" />
        </mxCell>

        <mxCell id="s3_bp_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:10px;&quot;&gt;[ 그림: float 곱셈 회로 ]&lt;br/&gt;x (float32) × 0.625 → FPU 필요&lt;br/&gt;DPU에서 수십 사이클 소요&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#D94F3D;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="484" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3_bp_txt" value="&lt;font color=&quot;#E67E22&quot;&gt;⚠ 메시지 엣지마다 float 곱셈 — FPU 없는 DPU에서 극히 느림&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#E67E22;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="577" width="680" height="28" as="geometry" />
        </mxCell>

        <mxCell id="s3_nms_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:10px;&quot;&gt;[ 그림: 비트 시프트 연산 흐름도 ]&lt;br/&gt;x → (x &lt;&lt; 2) → + x → (&gt;&gt; 3) → 결과&lt;br/&gt;3개 정수 명령어로 0.625 곱셈 대체&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FB;strokeColor=#2E86AB;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="484" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3_nms_txt" value="&lt;font color=&quot;#27AE60&quot;&gt;✓ shift + add 3개 명령어 — FPU 불필요, 완전 파이프라인 실행&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#27AE60;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="577" width="680" height="28" as="geometry" />
        </mxCell>

        <mxCell id="arr3_bp" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#D94F3D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s3_bp_txt" target="s4_bp_img">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr3_nms" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E86AB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s3_nms_txt" target="s4_nms_img">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- STEP 4: Variable Node Update -->
        <!-- ═══════════════════════════════════ -->
        <mxCell id="s4_label" value="STEP 4 — Variable Node Update" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
          <mxGeometry x="35" y="620" width="280" height="18" as="geometry" />
        </mxCell>

        <mxCell id="s4_bp_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:10px;&quot;&gt;[ 그림: Tanner 그래프 variable node ]&lt;br/&gt;variable node ← 3개 check node (float 합산)&lt;br/&gt;반복마다 float 누적 오차 발생&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#D94F3D;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="640" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4_bp_txt" value="&lt;font color=&quot;#E67E22&quot;&gt;⚠ degree-3 float 합산 — 반복마다 반올림 오차 누적&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#E67E22;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="733" width="680" height="28" as="geometry" />
        </mxCell>

        <mxCell id="s4_nms_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:10px;&quot;&gt;[ 그림: Tanner 그래프 variable node ]&lt;br/&gt;variable node ← c₀ + c₁ + c₂ (int16 덧셈 3번)&lt;br/&gt;BB 코드 variable degree=3 → 항상 고정 3회&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FB;strokeColor=#2E86AB;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="640" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4_nms_txt" value="&lt;font color=&quot;#27AE60&quot;&gt;✓ 정수 덧셈 3회 고정 — 결정론적 사이클, 오버플로우 없음(FP_MAX=32000)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#27AE60;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="733" width="680" height="28" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- 하단 요약 카드 4개 -->
        <!-- ═══════════════════════════════════ -->
        <mxCell id="sum_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#2E86AB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="782" width="1440" height="250" as="geometry" />
        </mxCell>
        <mxCell id="sum_title" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#2C3E50&quot;&gt;DPU Architecture Fit Summary&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="788" width="1440" height="24" as="geometry" />
        </mxCell>

        <!-- 카드 1: No FPU -->
        <mxCell id="sum1_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px;&quot;&gt;[ 그림: CPU FPU 블록 vs DPU ALU 블록 비교 ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAFAF1;strokeColor=#27AE60;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="45" y="818" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sum1_txt" value="&lt;b&gt;&lt;font color=&quot;#27AE60&quot;&gt;✓ No FPU Required&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;NMS는 비교·시프트·덧셈만 사용.&lt;br/&gt;DPU 정수 ALU로 완전 실행 가능." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="45" y="893" width="330" height="125" as="geometry" />
        </mxCell>

        <!-- 카드 2: WRAM -->
        <mxCell id="sum2_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px;&quot;&gt;[ 그림: WRAM 블록 — float32 절반 채움 vs int16 가득 채움 ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FB;strokeColor=#2E86AB;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="395" y="818" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sum2_txt" value="&lt;b&gt;&lt;font color=&quot;#2E86AB&quot;&gt;✓ WRAM Efficiency&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;int16(2B) vs float32(4B)&lt;br/&gt;→ WRAM에 2배 메시지 저장.&lt;br/&gt;MRAM 접근 횟수 감소." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="395" y="893" width="330" height="125" as="geometry" />
        </mxCell>

        <!-- 카드 3: Pipeline -->
        <mxCell id="sum3_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px;&quot;&gt;[ 그림: DPU 파이프라인 타이밍 다이어그램 — 고정 사이클, stall 없음 ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FB;strokeColor=#2E86AB;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="745" y="818" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sum3_txt" value="&lt;b&gt;&lt;font color=&quot;#2E86AB&quot;&gt;✓ Pipeline Friendly&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;고정 횟수 반복 → 분기 stall 없음.&lt;br/&gt;11개 tasklet이 완전 병렬 실행." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="745" y="893" width="330" height="125" as="geometry" />
        </mxCell>

        <!-- 카드 4: Deterministic -->
        <mxCell id="sum4_img" value="&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px;&quot;&gt;[ 그림: CPU tail latency 분포(넓음) vs DPU 분포(수직선) 비교 ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAFAF1;strokeColor=#27AE60;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1095" y="818" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sum4_txt" value="&lt;b&gt;&lt;font color=&quot;#27AE60&quot;&gt;✓ Deterministic Latency&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;정수 고정 반복 → 사이클 정확 실행.&lt;br/&gt;OS 지터·캐시 미스 없음.&lt;br/&gt;Tail latency = Average latency." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1095" y="893" width="360" height="125" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
