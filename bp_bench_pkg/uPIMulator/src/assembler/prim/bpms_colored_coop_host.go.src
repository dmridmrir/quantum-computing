package prim

import (
	"errors"
	"fmt"
	"math/rand"
	"uPIMulator/src/abi/encoding"
	"uPIMulator/src/abi/word"
	"uPIMulator/src/misc"
)

// BP-PIM cooperative host for the project error-rate sweep. Runtime parameters
// are prior_q8,n_iter,error_ppm,seed. Mapping stays fixed at 11 tasklets per
// syndrome, while n_iter is swept from 1 through 10.
type Bpms struct {
	num_dpus       int
	num_tasklets   int
	num_executions int
	nc             int64
	nv             int64
	prior          int16
	nIter          int
	errorPpm       int
	seed           int64
	syndrome       []byte
}

func (this *Bpms) Init(command_line_parser *misc.CommandLineParser) {
	numChannels := int(command_line_parser.IntParameter("num_channels"))
	numRanks := int(command_line_parser.IntParameter("num_ranks_per_channel"))
	numDpus := int(command_line_parser.IntParameter("num_dpus_per_rank"))
	this.num_dpus = numChannels * numRanks * numDpus
	this.num_tasklets = int(command_line_parser.IntParameter("num_tasklets"))
	if this.num_tasklets != 11 {
		panic(fmt.Errorf("BP-PIM v2 requires exactly 11 tasklets, got %d", this.num_tasklets))
	}
	this.num_executions = 1
	this.nc, this.nv = 72, 144
	params := command_line_parser.DataPrepParams()
	if len(params) != 4 {
		panic(fmt.Errorf("BP-PIM v2 data_prep_params must be prior_q8,n_iter,error_ppm,seed"))
	}
	this.prior = int16(params[0])
	this.nIter = params[1]
	this.errorPpm = params[2]
	this.seed = int64(params[3])
	if this.prior <= 0 || int(this.prior) > bpFpMax {
		panic(fmt.Errorf("prior_q8 must be in [1,%d], got %d", bpFpMax, this.prior))
	}
	if this.nIter < 1 || this.nIter > 10 {
		panic(fmt.Errorf("BP-PIM v2 iter must be in [1,10], got %d", this.nIter))
	}
	if this.errorPpm < 1000 || this.errorPpm > 9000 {
		panic(fmt.Errorf("error_ppm must be in [1000,9000], got %d", this.errorPpm))
	}

	rng := rand.New(rand.NewSource(this.seed))
	errVec := make([]byte, this.nv)
	for i := range errVec {
		if rng.Intn(1000000) < this.errorPpm {
			errVec[i] = 1
		}
	}
	this.syndrome = make([]byte, this.nc)
	for chk := 0; chk < int(this.nc); chk++ {
		var s byte
		for j := 0; j < bpChkDeg; j++ {
			s ^= errVec[bpChkVarsData[chk][j]]
		}
		this.syndrome[chk] = s
	}
}

func (this *Bpms) InputDpuHost(execution int, dpuID int) map[string]*encoding.ByteStream {
	if execution >= this.num_executions {
		panic(errors.New("execution >= num executions"))
	}
	bs := new(encoding.ByteStream)
	bs.Init()
	for _, value := range []int64{int64(this.prior), this.nc, this.nv, int64(this.nIter), 1, 2, 0} {
		w := new(word.Word)
		w.Init(32)
		w.SetValue(value)
		bs.Merge(w.ToByteStream())
	}
	return map[string]*encoding.ByteStream{"DPU_INPUT_ARGUMENTS": bs}
}

func (this *Bpms) OutputDpuHost(execution int, dpuID int) map[string]*encoding.ByteStream {
	return make(map[string]*encoding.ByteStream)
}

func (this *Bpms) InputDpuMramHeapPointerName(execution int, dpuID int) (int64, *encoding.ByteStream) {
	bs := new(encoding.ByteStream)
	bs.Init()
	for _, b := range this.syndrome {
		w := new(word.Word)
		w.Init(8)
		w.SetValue(int64(b))
		bs.Merge(w.ToByteStream())
	}
	return 0, bs
}

func (this *Bpms) OutputDpuMramHeapPointerName(execution int, dpuID int) (int64, *encoding.ByteStream) {
	bs := new(encoding.ByteStream)
	bs.Init()
	post, _ := bpDecodeLayeredV2(this.syndrome, this.prior, this.nIter)
	for _, val := range post {
		lo := new(word.Word)
		lo.Init(8)
		lo.SetValue(int64(uint8(val & 0xFF)))
		bs.Merge(lo.ToByteStream())
		hi := new(word.Word)
		hi.Init(8)
		hi.SetValue(int64(uint8((val >> 8) & 0xFF)))
		bs.Merge(hi.ToByteStream())
	}
	return 72, bs
}

func (this *Bpms) NumExecutions() int { return this.num_executions }
